{
    "name": "nhom2/quan-ly-dat-ve-worldcup-2030",
    "type": "project",
    "description": "Hệ thống Quản lý và Đặt vé FIFA World Cup 2030",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "barryvdh/laravel-dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
